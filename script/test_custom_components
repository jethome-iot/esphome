#!/usr/bin/env python3
"""Test runner for custom ESPHome components."""

import os
import subprocess
import sys
from pathlib import Path

# Color codes for terminal output
GREEN = '\033[92m'
RED = '\033[91m'
YELLOW = '\033[93m'
RESET = '\033[0m'
BOLD = '\033[1m'

# List of custom components to test
CUSTOM_COMPONENTS = [
    'dallas_temp_searcher',
    'dynamic_entity_settings',
    'groups',
    'ota_rollback',
    'user_names',
]

def run_test(component_name, test_file):
    """Run a single test file."""
    print(f"  Testing {test_file}...", end=' ')
    
    test_path = f"tests/components/{component_name}/{test_file}"
    if not os.path.exists(test_path):
        print(f"{YELLOW}SKIP{RESET} (file not found)")
        return True  # Don't fail if file doesn't exist
    
    try:
        result = subprocess.run(
            ['esphome', 'compile', test_path],
            capture_output=True,
            text=True,
            timeout=120
        )
        
        if result.returncode == 0:
            print(f"{GREEN}PASS{RESET}")
            return True
        else:
            print(f"{RED}FAIL{RESET}")
            if result.stderr:
                print(f"    Error: {result.stderr[:200]}")
            return False
    except subprocess.TimeoutExpired:
        print(f"{RED}TIMEOUT{RESET}")
        return False
    except Exception as e:
        print(f"{RED}ERROR{RESET}: {str(e)}")
        return False

def main():
    """Main test runner."""
    print(f"{BOLD}ESPHome Custom Components Test Runner{RESET}")
    print(f"Testing components: {', '.join(CUSTOM_COMPONENTS)}")
    print("-" * 60)
    
    total_tests = 0
    passed_tests = 0
    failed_components = []
    
    for component in CUSTOM_COMPONENTS:
        print(f"\n{BOLD}Testing {component}...{RESET}")
        
        component_passed = True
        
        # Test ESP32 Arduino configuration
        if component != 'ota_rollback':  # ota_rollback is IDF only
            total_tests += 1
            if run_test(component, 'test.esp32-ard.yaml'):
                passed_tests += 1
            else:
                component_passed = False
        
        # Test ESP32 IDF configuration  
        total_tests += 1
        if run_test(component, 'test.esp32-idf.yaml'):
            passed_tests += 1
        else:
            component_passed = False
        
        if not component_passed:
            failed_components.append(component)
    
    # Print summary
    print("\n" + "=" * 60)
    print(f"{BOLD}Test Summary{RESET}")
    print(f"Total tests run: {total_tests}")
    print(f"Passed: {GREEN}{passed_tests}{RESET}")
    print(f"Failed: {RED}{total_tests - passed_tests}{RESET}")
    
    if failed_components:
        print(f"\nComponents with failures: {RED}{', '.join(failed_components)}{RESET}")
        return 1
    else:
        print(f"\n{GREEN}All tests passed!{RESET}")
        return 0

if __name__ == '__main__':
    sys.exit(main())